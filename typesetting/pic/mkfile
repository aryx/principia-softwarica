TOP=../..
<$TOP/mkfiles/$objtype/mkfile

TARG=pic

# claude: was picy.$O (via a "mv y.tab.c picy.c" rule below) -- every
# other yacc user in this repo (hoc, rc, cc, acid, this dir's own eqn
# sibling) just uses y.tab.$O directly. Renaming added a second graph
# edge into the same "y.tab.h y.tab.c: $YFILES" recipe that every
# other .$O here already reaches via HFILES, which could race under
# this repo's $NPROC-driven parallel builds (corrupting whichever .c
# file read y.tab.h/.c mid-write, seen as "name not declared" for
# random pic.y tokens). Matching the rest of the repo removes the
# extra edge instead of just papering over the race.
OFILES=y.tab.$O\
	picl.$O\
	main.$O\
	print.$O\
	misc.$O\
	symtab.$O\
	blockgen.$O\
	boxgen.$O\
	circgen.$O\
	arcgen.$O\
	linegen.$O\
	movegen.$O\
	textgen.$O\
	input.$O\
	for.$O\
	pltroff.$O\

HFILES=pic.h y.tab.h

YFILES=picy.y

<$TOP/mkfiles/mkone

CC=pcc
LD=pcc
CFLAGS=-FTV -c -I$TOP/APE/include -I$TOP/APE/include/$objtype
# claude: the .../lib (not .../lib/ape) entry is for libl.a, pulled in
# by lex's own generated ncform driver via #pragma lib "libl.a"
LDFLAGS=-L$TOP/ROOT/arch/$objtype/lib/ape -L$TOP/ROOT/arch/$objtype/lib
YFLAGS=-S -d

picl.c:	picl.lx
	$LEX -t $prereq > $target

CLEANFILES=picl.c
