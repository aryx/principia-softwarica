TOP=../..
<$TOP/mkfiles/$objtype/mkfile

TARG=pic

OFILES=picy.$O\
	picl.$O\
	main.$O\
	print.$O\
	misc.$O\
	symtab.$O\
	blockgen.$O\
	boxgen.$O\
	circgen.$O\
	arcgen.$O\
	linegen.$O\
	movegen.$O\
	textgen.$O\
	input.$O\
	for.$O\
	pltroff.$O\

HFILES=pic.h y.tab.h

YFILES=picy.y

<$TOP/mkfiles/mkone

CC=pcc
LD=pcc
CFLAGS=-FTV -c -I$TOP/APE/include -I$TOP/APE/include/$objtype
# claude: the .../lib (not .../lib/ape) entry is for libl.a, pulled in
# by lex's own generated ncform driver via #pragma lib "libl.a"
LDFLAGS=-L$TOP/ROOT/arch/$objtype/lib/ape -L$TOP/ROOT/arch/$objtype/lib
YFLAGS=-S -d

# claude: depend on y.tab.h too, not just y.tab.c -- both are produced
# by the SAME "y.tab.h y.tab.c: $YFILES" recipe (in mkone) that every
# other .$O here also reaches via HFILES. Naming only y.tab.c reaches
# that recipe through a second, separate graph edge; under -j (this
# repo sets $NPROC) that diamond occasionally raced picy.c's rename
# against y.tab.h/.c still being written, corrupting whichever .c file
# read it mid-write ("name not declared" for random pic.y tokens).
# Naming both here collapses it back to a single edge everyone shares.
picy.c:	y.tab.c y.tab.h
	mv $prereq(1) $target

picl.c:	picl.lx
	$LEX -t $prereq > $target

CLEANFILES=picy.c picl.c
