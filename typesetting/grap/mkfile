TOP=../..
<$TOP/mkfiles/$objtype/mkfile

TARG=grap

# claude: was grap.$O (via a "mv y.tab.c grap.c" rule below) -- see
# pic/mkfile's identical comment; matching every other yacc user in
# this repo (hoc, rc, cc, acid, this dir's own eqn sibling), which all
# just use y.tab.$O directly, removes a diamond into the shared
# "y.tab.h y.tab.c: $YFILES" recipe instead of just papering over the
# race it could cause under this repo's $NPROC-driven parallel builds.
OFILES=\
	y.tab.$O\
	grapl.$O\
	main.$O\
	input.$O\
	print.$O\
	frame.$O\
	for.$O\
	coord.$O\
	ticks.$O\
	plot.$O\
	label.$O\
	misc.$O\

HFILES=grap.h y.tab.h

YFILES=grap.y

LFILES=grapl.lx

<$TOP/mkfiles/mkone

CC=pcc
LD=pcc
YFLAGS= -d -S
CFLAGS=-FTV -c -I$TOP/APE/include -I$TOP/APE/include/$objtype
# claude: the .../lib (not .../lib/ape) entry is for libl.a, pulled in
# by lex's own generated ncform driver via #pragma lib "libl.a"
LDFLAGS=-L$TOP/ROOT/arch/$objtype/lib/ape -L$TOP/ROOT/arch/$objtype/lib

grapl.c:	$LFILES
	$LEX -t $prereq > $target

CLEANFILES=grapl.c

