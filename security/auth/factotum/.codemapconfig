  name: name,
  bones: [
    { at: file + ':def:' + rec, role: 'the Proto record: its functions, called by pointer' },
    { at: file + ':' + init, role: 'start: the key found, the first phase set' },
    { at: file + ':' + write, role: 'a message in: the phase advanced' },
    { at: file + ':' + read, role: 'a message out, for this phase' },
    { at: 'util.c:def:findkey', role: 'the key, matched by its attributes' },
    { at: 'rpc.c:def:rpcread', role: 'the caller: an RPC run' },
