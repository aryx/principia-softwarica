    { from: 'rpc.c:def:rpcread', to: file + ':' + write, say: 'write: the peer\'s bytes' },
    { from: 'rpc.c:def:rpcread', to: file + ':' + read, say: 'read: bytes for the peer' },
  ] + role,
};
